# Amazon Business / SP-API credentials
AMAZON_CLIENT_ID=amzn1.application-oa2-client.xxxx
AMAZON_CLIENT_SECRET=your-secret
AMAZON_REFRESH_TOKEN=your-refresh-token
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER

# Microsoft Dynamics 365 credentials
DYNAMICS_TENANT_ID=your-azure-tenant-id
DYNAMICS_CLIENT_ID=your-app-registration-client-id
DYNAMICS_CLIENT_SECRET=your-client-secret
DYNAMICS_RESOURCE_URL=https://your-org.operations.dynamics.com

# API type: "finance_operations" or "business_central"
DYNAMICS_API_TYPE=finance_operations

# Only needed for Business Central
DYNAMICS_BC_COMPANY_ID=
